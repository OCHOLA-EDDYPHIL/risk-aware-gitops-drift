---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: radar-lab
  namespace: argocd
spec:
  project: radar
  source:
    repoURL: REPLACE_WITH_RADAR_REPOSITORY_URL
    targetRevision: REPLACE_WITH_RADAR_TARGET_REVISION
    path: k8s-lab/baseline
  destination:
    server: https://kubernetes.default.svc
    namespace: radar-demo
  syncPolicy:
    automated:
      enabled: true
      prune: false
      selfHeal: false
    syncOptions:
      - CreateNamespace=true
