{
  "name": "RADAR controlled research lab",
  "image": "mcr.microsoft.com/devcontainers/base@sha256:bb7b81b6e5be17b5267f92f4ffda534fea37dab1df97b5e86c1f9b91da5c0b5d",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.0.0": {
      "version": "29.6.2",
      "moby": true,
      "installDockerBuildx": false,
      "dockerDashComposeVersion": "none"
    },
    "ghcr.io/devcontainers/features/sshd:1.1.0": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "postCreateCommand": "bash .devcontainer/install-tools.sh",
  "remoteUser": "vscode",
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.radar-env/go/bin:${containerWorkspaceFolder}/.radar-env/python/bin:${containerWorkspaceFolder}/.radar-env/bin:${containerEnv:PATH}",
    "GOROOT": "${containerWorkspaceFolder}/.radar-env/go",
    "GOPATH": "${containerWorkspaceFolder}/.radar-env/state/go",
    "GOMODCACHE": "${containerWorkspaceFolder}/.radar-env/cache/go-mod",
    "GOCACHE": "${containerWorkspaceFolder}/.radar-env/cache/go-build",
    "GOTOOLCHAIN": "local",
    "VIRTUAL_ENV": "${containerWorkspaceFolder}/.radar-env/python",
    "PYTHONNOUSERSITE": "1",
    "PIP_CACHE_DIR": "${containerWorkspaceFolder}/.radar-env/cache/pip",
    "MINIKUBE_HOME": "${containerWorkspaceFolder}/.radar-env/state/minikube",
    "KUBECONFIG": "${containerWorkspaceFolder}/.radar-env/state/kubeconfig",
    "RADAR_TOKEN_FILE": "${containerWorkspaceFolder}/.radar-env/state/radar-token",
    "RADAR_UI_PASSWORD_FILE": "${containerWorkspaceFolder}/.radar-env/state/argocd-ui-password",
    "RADAR_ENV_ROOT": "${containerWorkspaceFolder}/.radar-env",
    "RADAR_ENV_ACTIVE": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "redhat.vscode-yaml"
      ]
    }
  }
}
